# Local preview; never commit your real .env file.
DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
OWNER_ID_MODE=local_demo

# Create a NEW Supabase project named GoRent, then copy its Session pooler URI.
# The reference is the part after "postgres." in the pooler username.
SUPABASE_PROJECT_REF=your-new-gorent-project-ref
DATABASE_URL=postgresql://postgres.your-new-gorent-project-ref:URL_ENCODED_DB_PASSWORD@YOUR-POOLER-HOST.pooler.supabase.com:5432/postgres?sslmode=require

# Optional car photo uploads.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
